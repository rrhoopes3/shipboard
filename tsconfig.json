{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/http/**/*.ts", "src/local/**/*.ts", "runner/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
